{
  "name": "wacrm-website-cms",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html WACRM-CMS.html && cp dist/index.html dist/WACRM-CMS.html && npm run handover && npm run package",
    "preview": "vite preview",
    "serve": "python3 serve.py",
    "handover": "node scripts/handover.mjs",
    "qa": "node scripts/qa-all.mjs",
    "qa:check": "node scripts/handover.mjs --check",
    "package": "node scripts/package.mjs",
    "fonts": "node scripts/fetch-theme-fonts.mjs --budget=10.5",
    "prebuild": "node scripts/ensure-font-data.mjs",
    "predev": "node scripts/ensure-font-data.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
